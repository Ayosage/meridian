# The game Worker's http(s) origin: the client POSTs to it and derives the
# ws(s):// socket url from it. Dev default is http://localhost:8787 (wrangler
# dev; or the PORT override, see README "Ports"). Production: the deployed
# Worker, e.g. https://meridian.<account>.workers.dev.
VITE_SERVER_URL=https://meridian.example.workers.dev
